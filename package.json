{
  "name": "task-terminal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "本地优先的个人 AI 任务台",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "verify": "pnpm run typecheck && node --test --test-isolation=none scripts/verify/m0.test.ts scripts/verify/m1.test.ts scripts/verify/m2.test.ts scripts/verify/m3.test.ts scripts/verify/m4.test.ts",
    "verify:m0": "node --test --test-isolation=none scripts/verify/m0.test.ts",
    "verify:m1": "node --test --test-isolation=none scripts/verify/m1.test.ts",
    "verify:m2": "node --test --test-isolation=none scripts/verify/m2.test.ts",
    "verify:m3": "node --test --test-isolation=none scripts/verify/m3.test.ts",
    "verify:m4": "node --test --test-isolation=none scripts/verify/m4.test.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "fastify": "^5.12.7"
  }
}
